<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.secondbrain-coach</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>$HOME/.secondbrain/run-weekly-coach.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>5</integer>
        <key>Hour</key>
        <integer>16</integer>
        <key>Minute</key>
        <integer>9</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/secondbrain-coach.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/secondbrain-coach.err</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
