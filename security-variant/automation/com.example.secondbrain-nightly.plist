<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.secondbrain-nightly</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>$HOME/.secondbrain/run-nightly.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>16</integer>
        <key>Minute</key>
        <integer>9</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/secondbrain-nightly.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/secondbrain-nightly.err</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
